# Dipendenze: si reinstallano con `npm install`, non vanno nel repository.
# `package.json` e `package-lock.json` invece SÌ: Netlify li legge per
# installare le librerie della funzione /api durante la build.
node_modules/

# Segreti: la stringa di connessione al database e le chiavi delle notifiche
# stanno fra le variabili d'ambiente di Netlify, mai in un file del progetto.
.env
.env.*
!.env.esempio

# Cartelle di lavoro di Netlify
.netlify/

# File di sistema
.DS_Store
Thumbs.db
